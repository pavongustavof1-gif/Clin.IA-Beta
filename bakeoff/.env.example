# bakeoff/.env — the ONLY file the bake-off reads secrets/settings from.
# Copy to bakeoff/.env (git-ignored) and fill in. Never the repo-root .env.
ASSEMBLYAI_API_KEY=
# Folder holding the invented-consultation audio (not in the repo), e.g.
# the iCloud Bakeoff folder; scenario YAMLs give paths relative to it.
BAKEOFF_AUDIO_DIR=
# extract aborts before the first call if the estimated cost exceeds this.
BAKEOFF_BUDGET_USD=5
